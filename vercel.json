{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "galernai.com"
        }
      ],
      "destination": "https://www.nuvsense.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.galernai.com"
        }
      ],
      "destination": "https://www.nuvsense.com/$1",
      "permanent": true
    },
    {
      "source": "/downloads/galernai-:file",
      "destination": "/downloads/nuvsense-:file",
      "permanent": true
    },
    {
      "source": "/downloads/altair-sense-:file",
      "destination": "/downloads/nuvsense-:file",
      "permanent": true
    },
    {
      "source": "/noticias/galernai-congreso-moda-cosmetica-belleza-retail-urjc",
      "destination": "/noticias/nuvsense-congreso-moda-cosmetica-belleza-retail-urjc",
      "permanent": true
    },
    {
      "source": "/en/news/galernai-congreso-moda-cosmetica-belleza-retail-urjc",
      "destination": "/en/news/nuvsense-congreso-moda-cosmetica-belleza-retail-urjc",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}